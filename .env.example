# Google API Key (required)
# Get from: https://aistudio.google.com/apikey
GOOGLE_API_KEY="your_google_api_key_here"

# Phoenix Tracing (optional - for observability)
# Get from: https://app.phoenix.arize.com
PHOENIX_API_KEY="your_phoenix_api_key_here"
PHOENIX_COLLECTOR_ENDPOINT="https://app.phoenix.arize.com/s/your-space-name"
PHOENIX_PROJECT_NAME="voice-agent-tools"
ENABLE_PHOENIX_TRACING="true"
